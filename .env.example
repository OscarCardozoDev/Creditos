# Copiar a .env y rellenar. La API no arranca si falta una variable obligatoria.

NODE_ENV=development
PORT=3000

# SQL Server. La contrasena debe cumplir la politica del motor:
# 8+ caracteres con mayusculas, minusculas y digitos.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Creditos
DB_USER=sa
DB_PASSWORD=CambieEsto123
# Puerto que el contenedor de SQL Server publica en la maquina anfitriona.
DB_PORT_HOST=1433

SESSION_COOKIE_NAME=__Host-sid
SESSION_INACTIVIDAD_MIN=30
SESSION_ABSOLUTA_HORAS=8

WEBHOOK_URL=http://host.docker.internal:4000/receptor
WEBHOOK_SECRET=secreto-local-de-desarrollo-cambiar
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_INTENTOS=8
WORKER_INTERVALO_MS=10000

CORS_ORIGINS=http://localhost:5173

# Puerto en el que la API queda publicada en la maquina anfitriona.
API_PORT_HOST=3010
